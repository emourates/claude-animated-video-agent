import json
import re
from typing import Any, Dict

from anthropic import Anthropic

from app.config import settings


SYSTEM_PROMPT = """
You are a senior creative director and motion graphics strategist.
Generate short-form vertical videos optimized for Instagram Reels, TikTok, and YouTube Shorts.
Return valid JSON only.

Requirements:
- 9:16 aspect ratio
- 15-45 seconds
- energetic pacing
- visually clear scene-by-scene structure
- include title, caption, hashtags, and scene list
- scenes must include text overlays and visual descriptions
- keep output compact but useful for rendering
"""


def _extract_json(raw_text: str) -> Dict[str, Any]:
    match = re.search(r"\{.*\}", raw_text, re.DOTALL)
    if not match:
        raise ValueError("Claude response did not include valid JSON.")
    return json.loads(match.group(0))


def generate_storyboard(prompt: str, model: str = "claude-3-5-sonnet-20241022") -> Dict[str, Any]:
    if not settings.ANTHROPIC_API_KEY:
        raise RuntimeError("ANTHROPIC_API_KEY is missing. Add it to your .env file.")

    client = Anthropic(api_key=settings.ANTHROPIC_API_KEY)
    response = client.messages.create(
        model=model,
        max_tokens=1200,
        temperature=0.7,
        system=SYSTEM_PROMPT,
        messages=[
            {
                "role": "user",
                "content": (
                    f"Create a storyboard for the following short-form animated video concept: "
                    f"{prompt}\n\n"
                    "Return JSON in this shape:\n"
                    "{\n"
                    "  'title': '...',\n"
                    "  'duration_seconds': 20,\n"
                    "  'caption': '...',\n"
                    "  'hashtags': ['#example'],\n"
                    "  'scenes': [\n"
                    "    {'start': 0, 'end': 3, 'text': 'Title card', 'visual': '...', 'motion': '...'}\n"
                    "  ]\n"
                    "}"
                ),
            }
        ],
    )

    text = response.content[0].text
    return _extract_json(text)
